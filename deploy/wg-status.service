# /etc/systemd/system/wg-status.service
#
#   install -m0755 wg-status /usr/local/bin/wg-status
#   install -m0640 wg-status.example.conf /etc/wg-status/wg-status.conf
#   systemctl daemon-reload && systemctl enable --now wg-status
#
# Notes:
#   - Runs as root because `wg show` reads the WireGuard netlink and the restart
#     command shells out to systemctl/wg-quick. If you lock this down further,
#     grant CAP_NET_ADMIN and a sudoers rule for the restart command instead.
[Unit]
Description=WireGuard status page
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/wg-status -config /etc/wg-status/wg-status.conf
Restart=on-failure
RestartSec=5
# Hardening (relax if it conflicts with your restart command):
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
